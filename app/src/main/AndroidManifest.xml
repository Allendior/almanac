<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Declared permissions, in full:

        CAMERA         - the one thing this app does.
        USE_BIOMETRIC  - merged in by androidx.biometric, used only for the optional
                         app lock. It cannot read anything; it asks the OS to confirm
                         it is you, and the OS answers yes or no.

      There is deliberately no INTERNET, no location, no external storage, and no
      package-visibility query. Verified against the packaged APK, not against this
      file, with: aapt dump permissions <apk>

      USE_FINGERPRINT is removed below: androidx.biometric merges it for API 23-28,
      and this app's minimum is 29, so it would be a permission that is declared and
      never used.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <application
        android:name=".AlmanacApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Almanac">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Almanac">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
