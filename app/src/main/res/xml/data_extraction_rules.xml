<?xml version="1.0" encoding="utf-8"?>
<!--
  Portraits and their metadata never leave the device through cloud backup
  or device-to-device transfer. The only sanctioned copy is the explicit
  ZIP export the owner creates through the system file picker.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
